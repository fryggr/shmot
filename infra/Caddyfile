{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Внутренние и служебные пути API наружу не отдаём (web проксирует только /api/v1/*)
	@blocked path /internal* /docs* /openapi.json /redoc*
	respond @blocked 404

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		# POC: индексация закрыта целиком
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	reverse_proxy web:3000
}

# www → основной домен
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

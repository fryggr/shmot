{
	email {$ACME_EMAIL}
}

# DOMAIN: «example.ru» — HTTPS с автоматическим сертификатом;
#         «example.ru, www.example.ru» — несколько адресов;
#         «http://<IP>» — временно, пока домен не привязан (без шифрования).
{$DOMAIN} {
	encode zstd gzip

	# Внутренние и служебные пути API наружу не отдаём (web проксирует только /api/v1/*)
	@blocked path /internal* /docs* /openapi.json /redoc*
	respond @blocked 404

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		# POC: индексация закрыта целиком
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	reverse_proxy web:3000
}

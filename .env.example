# Скопируйте в .env и задайте значения. .env не коммитится.
# Для docker compose значения по умолчанию уже прописаны в infra/compose.yaml.

DATABASE_URL=postgresql://fashion:fashion@localhost:5432/fashion
OPENSEARCH_URL=http://localhost:9200            # этап 3
REDIS_URL=redis://localhost:6379/0

# Закрытое хранилище исходных снимков. Без endpoint снимки пишутся в FASHION_SNAPSHOT_DIR.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=feed-snapshots
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
FASHION_SNAPSHOT_DIR=.data/snapshots

# Модели (этапы 4+). На этапе 1 не используются.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
QUERY_PARSER_MODEL=
QUERY_PARSER_API_KEY=

# Bearer-токен для /internal/*. Без него внутренние эндпоинты отключены (503).
INTERNAL_API_TOKEN=
# Подпись курсоров пагинации
CURSOR_SECRET=
RATE_LIMIT_PER_MINUTE=120

# URL фидов — только через секреты (feed_sources.secret_ref = env:ИМЯ). В логи не попадают.
# fixture:// — локальные демо-файлы из tests/fixtures/feeds.
FEED_URL_DEMO_SHOP_A=fixture://demo_shop_a_v1.yml
FEED_URL_DEMO_SHOP_B=fixture://demo_shop_b_v1.yml
# Хосты, с которых разрешено скачивать http(s)-фиды (через запятую)
FEED_ALLOWED_HOSTS=

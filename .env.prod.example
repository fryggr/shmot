# Скопируйте на сервере в .env.prod (chmod 600) и заполните. Файл не коммитится.
# Секреты: openssl rand -hex 32

DOMAIN=example.ru                    # домен, A-запись которого указывает на IP сервера
ACME_EMAIL=you@example.com           # для уведомлений Let's Encrypt

POSTGRES_PASSWORD=
INTERNAL_API_TOKEN=
CURSOR_SECRET=

# 1 — при каждом старте init импортирует демо-фиды (повтор безопасен: unchanged)
DEMO_IMPORT_ON_START=1
API_WORKERS=2
RATE_LIMIT_PER_MINUTE=120

# Реальные фиды — только после разрешения источника (docs/source-audit.md)
# FEED_URL_<ИСТОЧНИК>=https://...
# FEED_ALLOWED_HOSTS=feeds.example.ru
